{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaiMotionDemo",
  "version": "0.1.0",
  "identifier": "dev.silver0416.maimotiondemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MaiMotionDemo", "width": 1440, "height": 960, "minWidth": 960, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
