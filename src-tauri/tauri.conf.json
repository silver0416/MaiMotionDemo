{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaiMotionDemo",
  "version": "1.0.8",
  "identifier": "dev.silver0416.maimotiondemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaiMotionDemo",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https://i.ytimg.com; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/videos/**",
          "$APPLOCALDATA/models/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
