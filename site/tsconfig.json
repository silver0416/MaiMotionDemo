{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "$app/components/*": ["../frontend/src/components/*"],
      "$app/lib/*": ["../frontend/src/lib/*"],
      "$app/state/*": ["../frontend/src/state/*"],
      "$app/styles/*": ["../frontend/src/styles/*"],
      "$app/video/*": ["../frontend/src/video/*"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/service-worker"]
}
